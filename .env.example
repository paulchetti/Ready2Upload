# ==============================================================================
# Standalone AI Content Production Platform — Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Storage Configuration
# Absolute or relative path to store all project assets, audio, video, and renders
STORAGE_DIR=./storage

# Database Configuration
DATABASE_URL=file:./dev.db

# Autonomy & Production Defaults
# Options: LEVEL_1_ASSISTED, LEVEL_2_PRODUCTION, LEVEL_3_AUTONOMOUS
DEFAULT_AUTONOMY_LEVEL=LEVEL_2_PRODUCTION

# Budget & Cost Limits (in USD)
# If a project exceeds this threshold, the workflow pauses and alerts the user
MAX_PROJECT_BUDGET_USD=5.00
DAILY_BUDGET_USD=25.00

# ------------------------------------------------------------------------------
# AI Provider Selection
# ------------------------------------------------------------------------------
# Options: mock, gemini, openai, anthropic
DEFAULT_LLM_PROVIDER=mock

# Options: mock, gemini, openai, stability
DEFAULT_IMAGE_PROVIDER=mock

# Options: mock, elevenlabs, openai, edgetts
DEFAULT_VOICE_PROVIDER=mock

# Options: mock, runway, luma, pika
DEFAULT_VIDEO_PROVIDER=mock

# ------------------------------------------------------------------------------
# Provider API Credentials
# (Leave blank or set to 'mock' to use the zero-cost local test simulator)
# ------------------------------------------------------------------------------

# Google Gemini API
GEMINI_API_KEY=

# OpenAI API (for GPT-4o, DALL-E 3, OpenAI TTS)
OPENAI_API_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# ElevenLabs API (for ultra-realistic voice cloning and narration)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Stability AI API (for Stable Diffusion XL / 3)
STABILITY_API_KEY=

# Runway / Luma / Video Generation API
VIDEO_GEN_API_KEY=

# ------------------------------------------------------------------------------
# Media Processing (FFmpeg) Configuration
# ------------------------------------------------------------------------------
# Optional: Path to custom ffmpeg binary (if blank, bundled ffmpeg-static is used)
FFMPEG_PATH=
FFPROBE_PATH=

# Video Rendering Defaults
DEFAULT_FPS=30
DEFAULT_VIDEO_BITRATE=4500k
DEFAULT_AUDIO_BITRATE=192k
DEFAULT_AUDIO_LUFS=-14
